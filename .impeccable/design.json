      "html": "<button class=\"ds-secondary\">Listen to this voice</button>",
      "css": ".ds-secondary{font-family:Atkinson,system-ui,sans-serif;transition:background-color .15s ease,color .15s ease;border:1px solid var(--field-border,#b9c5d9);background:var(--surface,#fff);border-radius:7px;color:var(--ink,#182846);padding:8px 13px;font-size:13px;line-height:1.5;cursor:pointer}.ds-secondary:hover:enabled{background:var(--selection,#e6edff)}.ds-secondary:focus-visible{outline:3px solid var(--blue,#2455da);outline-offset:3px;}.ds-secondary:disabled{opacity:.4;cursor:default}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"

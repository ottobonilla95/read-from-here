      "refersTo": "passage",
      "description": "A paragraph-sized seek target; the current passage has a pale blue fill.",
      "html": "<button class=\"ds-passage\" aria-current=\"true\">A quiet place to study can make it easier to focus.</button><button class=\"ds-passage\">Give an idea some space.</button>",
      "css": ".ds-passage{font-family:Atkinson,system-ui,sans-serif;transition:background-color .15s ease,color .15s ease;display:block;border:0;border-radius:8px;padding:12px;width:100%;text-align:left;background:transparent;color:var(--muted,#53627b);font-size:15px;line-height:1.65;overflow-wrap:anywhere;cursor:pointer;margin-bottom:4px}.ds-passage:hover{background:var(--passage-hover,#edf1f9);color:var(--ink,#182846)}.ds-passage[aria-current=true]{background:var(--selection,#e6edff);color:var(--ink,#182846)}.ds-passage:focus-visible{outline:3px solid var(--blue,#2455da);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-passage{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "The Pocket Audio Guide",
    "overview": "A pocket museum audio guide adapted to studying: a compact cobalt transport sits beside the page, while cool white paper and quiet ink make the source text the main material. The interface feels calm, legible and immediately usable. Its visual identity comes from the play silhouette, readable type and passage highlighting rather than imagery.\n\nThe single column moves from source title to starting-point selection, playback and voice controls, then a continuous transcript. Voice settings open in place as a disclosure. The player is the one framed operational surface; passages remain part of a shared reading field.",
    "keyCharacteristics": [
      "A cobalt transport on cool white paper.",
      "Locally bundled, highly legible typography.",
      "A continuous transcript with one current-passage highlight.",
      "Compact controls and settings disclosed in place."
    ],
    "rules": [
      {
        "name": "The Cobalt Transport Rule",
        "body": "Concentrate solid cobalt in the play control; use it as text, outlines or small accents elsewhere.",
        "section": "colors"
      },
      {
        "name": "The Continuous Reading Rule",
        "body": "Preserve paragraph-sized text with generous leading; use weight and current-passage color rather than separate cards to distinguish passage roles.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Use tonal contrast and thin boundaries for structure; preserve the flat reading field around the player.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the source-title, start-selection, playback and transcript hierarchy.",
      "Do keep the transcript continuous and show the current passage with pale blue and ink.",
      "Do use the bundled regular and bold typefaces and visible keyboard focus.",
      "Do disclose voice settings in place and keep supporting hints beside their controls."
    ],
    "donts": [
      "Don't introduce marketing claims or decorative illustration into the listening panel.",
      "Don't turn every passage into a bordered or elevated card.",
      "Don't replace written playback states or recovery guidance with color alone.",
      "Don't add decorative shadows to the flat paper-and-surface system."
    ]
  }
}

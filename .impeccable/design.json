    {
      "name": "Playback container",
      "kind": "card",
      "refersTo": "player",
      "description": "The single framed operational surface, with status and a slim progress track.",
      "html": "<section class=\"ds-player\" aria-label=\"Playback controls\"><div class=\"ds-status\"><span>Ready to listen</span><span>1 / 9</span></div><progress class=\"ds-progress\" max=\"9\" value=\"1\" aria-label=\"Reading progress\"></progress></section>",
      "css": ".ds-player{font-family:Atkinson,system-ui,sans-serif;background:var(--surface,#fff);border:1px solid var(--line,#dce3ef);border-radius:14px;padding:17px 16px 12px;color:var(--ink,#182846)}.ds-status{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:12px;line-height:1.5;color:var(--muted,#53627b);font-variant-numeric:tabular-nums}.ds-status span:first-child{color:var(--ink,#182846)}.ds-progress{display:block;width:100%;height:4px;border:0;margin:12px 0 18px;appearance:none;background:var(--selection,#e6edff);border-radius:8px;overflow:hidden}.ds-progress::-webkit-progress-bar{background:var(--selection,#e6edff)}.ds-progress::-webkit-progress-value{background:var(--blue,#2455da)}"
    },
